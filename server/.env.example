# ============================================
# AVELIS Server — Environment Configuration Template
# Copy this file to server/.env for local development
# Do NOT commit server/.env to version control
# ============================================

NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:5173
CLIENT_URL=http://localhost:5173
CORS_MAX_AGE=86400

# Database (PostgreSQL / Supabase Connection Strings)
DATABASE_URL="postgresql://<USERNAME>:<PASSWORD>@localhost:5432/avelis_db?schema=public"
DIRECT_URL=""

# Authentication
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Supabase Integration & Storage Buckets
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_BOOK_COVERS_BUCKET=book-covers
SUPABASE_BOOK_PDFS_BUCKET=book-pdfs

# Google OAuth Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
